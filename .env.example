# Tapo MCP Configuration
# Copy to .env and fill in your values

# Tapo Cloud Credentials (for smart plugs via cloud API)
TAPO_CLOUD_EMAIL=
TAPO_CLOUD_PASSWORD=

# Tapo Camera Credentials (per-camera, or set in webapp settings)
TAPO_CAMERA_HOST=
TAPO_CAMERA_USERNAME=admin
TAPO_CAMERA_PASSWORD=

# Server
MCP_PORT=11102
WEB_PORT=11103
LOG_LEVEL=INFO
